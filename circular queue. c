#include <stdio.h>
#include <stdlib.h>

typedef struct node {
    int data;
    struct node* next;
} node;

typedef struct queue {
    node* front;
    node* rear;
} queue;

void init(queue* q) {
    q->front = NULL;
    q->rear = NULL;
}

node* createNode(int data) {
    node* n = (node*)malloc(sizeof(node));
    n->data = data;
    n->next = NULL;
    return n;
}

void enqueue(queue* q, int data) {
    node* n = createNode(data);

    // If queue is empty
    if (q->rear == NULL) {
        q->front = n;
        q->rear = n;
        n->next = q->front;  // circular link
        return;
    }

    q->rear->next = n;   // old rear points to new node
    q->rear = n;         // update rear
    q->rear->next = q->front;  // keep circular
}

int dequeue(queue* q) {
    if (q->front == NULL) {
        printf("Queue Underflow\n");
        return -1;
    }

    int val = q->front->data;

    // If only one node
    if (q->front == q->rear) {
        free(q->front);
        q->front = NULL;
        q->rear = NULL;
    } else {
        node* temp = q->front;
        q->front = q->front->next;
        q->rear->next = q->front;  // maintain circular link
        free(temp);
    }

    return val;
}

void display(queue* q) {
    if (q->front == NULL) {
        printf("Queue is empty\n");
        return;
    }

    node* temp = q->front;
    do {
        printf("%d ", temp->data);
        temp = temp->next;
    } while (temp != q->front);  // stop when full circle done

    printf("\n");
}

int main() {
    queue q;
    init(&q);

    enqueue(&q, 98);
    enqueue(&q, 94);
    enqueue(&q, 93);
    enqueue(&q, 92);

    printf("Queue elements: ");
    display(&q);

    printf("Deleted: %d\n", dequeue(&q));
    printf("Queue after deletion: ");
    display(&q);

    return 0;
}
