
#include <stdio.h>
#include<stdlib.h>

typedef struct node{
    int data;
    struct node* next;
}node;

typedef struct queue{
    node* front;
    node* rear;
}queue;

void inti(queue* q){
    q->front = NULL;
    q->rear = NULL;
}

node* createNode(int data){
    node* n = (node*)malloc(sizeof(node));
    n->data=data;
    n->next=NULL;
    return n;
}

void enqueue(queue* q,int val){
    node* n = createNode(val);
    if(q->rear==NULL){
        q->front=n;
        q->rear =n;
        return;
    }
    q->rear->next=n;
    q->rear=n;
}

int dequeue(queue* q){
    if(q->front==NULL){
        return -1;
    }
    node* temp = q->front;
    int val = temp->data;
    q->front = q->front->next;
  //  if(q->front==NULL){
    //    q->rear==NULL;
//    }
    free(temp);
    return val;
}

int display(queue* q){
    node* temp = q->front;
    while(temp!=NULL){
        printf("%d :",temp->data);
        temp = temp->next;
    }
    printf("\n");
}

int main(){
    queue q;
    inti(&q);
    
    enqueue(&q,10);
    enqueue(&q,20);
    enqueue(&q,30);
    display(&q);
    printf("%d",dequeue(&q));
    
    
    
    return 0;
}



